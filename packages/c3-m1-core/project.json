{
  "name": "c3-m1-core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/c3-m1-core/src",
  "tags": ["type:core", "scope:c3-m1"],
  "targets": {
    "generate-api": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx --yes openapi-typescript@7.13.0 ../../specs/c3-m1/openapi.yaml -o src/generated/c3-m1-api.d.ts",
        "cwd": "packages/c3-m1-core"
      }
    },
    "check-api": {
      "executor": "nx:run-commands",
      "options": { "command": "nx run c3-m1-core:generate-api && git diff --exit-code -- packages/c3-m1-core/src/generated" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "packages/c3-m1-core" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/c3-m1-core" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint packages/c3-m1-core" }
    }
  }
}
