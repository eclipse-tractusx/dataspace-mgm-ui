{
  "name": "portal-bff",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/portal-bff/src",
  "tags": ["type:app", "scope:bff"],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": { "command": "node src/main.ts", "cwd": "apps/portal-bff" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc -p tsconfig.json", "cwd": "apps/portal-bff" }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "apps/portal-bff" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint apps/portal-bff" }
    }
  }
}
