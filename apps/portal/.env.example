# Settings of the development BFF (dev-bff/dev-bff.ts) for `npm start`. Copy to .env.local (git-ignored).
# See docs/developers/integrate-a-backend-module.md.

# The installation of the backend (OSP A; OSP B of `demo.py --serve` is http://localhost:8001)
DEV_BFF_API_URL=http://localhost:8000
# Test person signed in by default (testdata/persons-osp-a.json of the backend)
DEV_BFF_PERSON=pia
# Realm of the Portal IAM (CX-Central-B for OSP B)
DEV_BFF_REALM=CX-Central
# Backend checkout, for iam/test/get-token.py when the backend runs with Keycloak
# DEV_BFF_SERVICE_DIR=../dataspace-mgm-service

# Mock mode: no backend, no BFF; the core packages use their in-memory adapters (src/core/mock-container.ts)
# VITE_USE_MOCKS=true
# Test person of mock mode, a key of MOCK_PERSONS (default pia; `none` = signed out)
# VITE_MOCK_PERSON=pia
