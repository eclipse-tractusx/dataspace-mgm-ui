{
  "name": "c1-m3-feature",
  "projectType": "library",
  "sourceRoot": "libs/c1-m3/feature/src",
  "tags": ["type:feature", "scope:c1-m3"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p libs/c1-m3/feature/tsconfig.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/c1-m3/feature"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --passWithNoTests",
        "cwd": "libs/c1-m3/feature"
      }
    }
  }
}
