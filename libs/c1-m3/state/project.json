{
  "name": "c1-m3-state",
  "projectType": "library",
  "sourceRoot": "libs/c1-m3/state/src",
  "tags": ["type:state", "scope:c1-m3"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
