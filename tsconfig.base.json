{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@dataspace-mgm/ui-mui": ["./libs/shared/ui-mui/src/index.ts"],
      "@dataspace-mgm/core-http": ["./packages/core-http/src/index.ts"],
      "@dataspace-mgm/identity-core": ["./packages/identity-core/src/index.ts"],
      "@dataspace-mgm/identity-core/testing": ["./packages/identity-core/src/testing.ts"],
      "@dataspace-mgm/c3-m1-core": ["./packages/c3-m1-core/src/index.ts"],
      "@dataspace-mgm/c3-m1-core/testing": ["./packages/c3-m1-core/src/testing.ts"],
      "@dataspace-mgm/c3-m2-core": ["./packages/c3-m2-core/src/index.ts"],
      "@dataspace-mgm/c3-m2-core/testing": ["./packages/c3-m2-core/src/testing.ts"]
    }
  }
}
