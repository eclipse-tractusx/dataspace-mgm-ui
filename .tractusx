# Metadata file for the Tractus-X release checks (TRG 2.05).
# See https://github.com/eclipse-tractusx/sig-release/blob/main/docs/metadata_file.md
# The leading repository of the product is dataspace-mgm-service (TRG 2.04).
leadingRepository: "https://github.com/eclipse-tractusx/dataspace-mgm-service"
repositories:
  - name: "dataspace-mgm-service"
    usage: "Leading repository: backend (modular monolith) of the Dataspace Management (new portal), product Helm chart, architecture and admin documentation"
    url: "https://github.com/eclipse-tractusx/dataspace-mgm-service"
  - name: "dataspace-mgm-ui"
    usage: "User interface of the Dataspace Management (new portal) and end user manual"
    url: "https://github.com/eclipse-tractusx/dataspace-mgm-ui"
